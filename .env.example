# Copy to .env and edit before deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000

# SQLite (default, stored in Docker volume) or PostgreSQL:
# DATABASE_URL=sqlite:////data/league.db
# DATABASE_URL=postgresql+psycopg://league:league@db:5432/league

COOKIE_SECURE=0
SESSION_HOURS=12
DISABLE_GSHEET_SYNC=0
